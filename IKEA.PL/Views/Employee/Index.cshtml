@model IEnumerable<EmployeeDto>
@{
 //    ViewData["Title"] = "Index";
 //    // Compiler Can Enforce The Type Safety
	// string? ViewDataMessage = ViewData["Message"] as string; //Faster Than ViewBag
	// //Compiler Will Escape Type Checking At Comilation Time
	// string ViewBagMessage = ViewBag.Message;
}

@if (!string.IsNullOrEmpty(TempData["Message"] as string))
{
    <div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTi-xgE1vyBhDJQJNdJKhVjmraoRqSsBYiFHg&s" class="rounded me-2" width="30" height="30" alt="Success">
                    <h5 class="modal-title text-success" id="modalLabel">Success!!</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @TempData["Message"]
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script>
@*         Trigger the modal to show on page load
 *@        document.addEventListener('DOMContentLoaded', function () {
            let modal = new bootstrap.Modal(document.getElementById('successModal'));
            modal.show();
        });
    </script>
}


@* <div class="alert alert-info">
    @ViewData["Message"]
</div>

<div class="alert alert-info">
    @ViewBag.Message
</div> *@
<div class="d-flex justify-content-between align-items-center">
    <h1>All Employees</h1>
    <form asp-action="Index" method="get" class="mt-5 row justify-content-center align-items-center">
        <div class="row col-8 offset-1">
            <div class="col-8">
                <input type="text" name="search" class="form-control" id="searchInp" placeholder="Search By Name" />
            </div>
            <div class="col-4">
                <input type="submit" value="Search" class="btn btn-success" />
            </div>
        </div>
    </form>
</div>
<br />
<br />
<a asp-controller="Employee" asp-action="Create" class="btn btn-primary"> Create New Employee </a>


@if (Model.Count() > 0)
{
    <table class="table table-striped tale-hover mt-4">
        <thead class="text-center">
            <tr>
                <th>@Html.DisplayNameFor(E => E.Name)</th>
                <th>@Html.DisplayNameFor(E => E.Email)</th>
                <th>@Html.DisplayNameFor(E => E.Department)</th>
                <th>@Html.DisplayNameFor(E => E.EmployeeType)</th>
				<th>@Html.DisplayNameFor(E => E.Age)</th>
				<th>@Html.DisplayNameFor(E => E.Salary)</th>
				<th>@Html.DisplayNameFor(E => E.IsActive)</th>
				<th>@Html.DisplayNameFor(E => E.Gender)</th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody class="text-center">
            @foreach (var employee in Model)
            {
                var modalId = $"deleteModal_{employee.Id}";
                <tr>
                    <td>@Html.DisplayFor(E => employee.Name)</td>
                    <td>@Html.DisplayFor(E => employee.Email)</td>
                    <td>@Html.DisplayFor(E => employee.Department)</td>
                    <td>@Html.DisplayFor(E => employee.EmployeeType)</td>
                    <td>@Html.DisplayFor(E => employee.Age)</td>
                    <td>@Html.DisplayFor(E => employee.Salary)</td>
                    <td>@Html.DisplayFor(E => employee.IsActive)</td>
                    <td>@Html.DisplayFor(E => employee.Gender)</td>
                    <partial name="_ButtonsPartial" model="@employee.Id" />
                    <td>
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#@modalId">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                    </td>
                </tr>
                <!-- Modal -->
                <div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="exampleModalLabel_@employee.Id" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h1 class="modal-title fs-5" id="exampleModalLabel_@employee.Id">Delete Employee</h1>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                Are you sure you want to delete this Employee "<strong>@employee.Name</strong>"?
                            </div>
                            <div class="modal-footer">
                                <form asp-action="Delete" asp-route-id="@employee.Id" method="post">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info mt-3">
        <h3 class="text-center"> Sorry There Is No Employees </h3>
    </div>
}
