@model RegisterVM
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Auth_Layout.cshtml";
}

<div class="container">
    <h2>Register</h2>
    <div asp-validation-summary="All" class="text-danger"></div>
    <form asp-action="Register" method="post">
        <input type="text" id="username" asp-for="FName" placeholder="Enter First Name" required>
        <span asp-validation-for="FName" class="text-danger"></span>
        <br />
        <input type="text" id="username" asp-for="LName" placeholder="Enter Last Name" required>
        <span asp-validation-for="LName" class="text-danger"></span>
        <br />
        <input type="email" id="email" asp-for="Email" placeholder="Enter E-Mail" required>
        <span asp-validation-for="Email" class="text-danger"></span>
        <br />
        <input type="password" id="password" asp-for="Password" placeholder="Enter Password" required>
        <span asp-validation-for="Password" class="text-danger"></span>
        <br />
        <input type="password" id="password" asp-for="ConfirmPassword" placeholder="Enter The Same Password Again" required>
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        <br />
        <div class="wthree-text">
            <label class="anim">
                <input asp-for="IsAgree" class="checkbox">
                <span> I accept the terms and conditions </span>
            </label>
            <div class="clear"> </div>
        </div>
        <input type="submit" value="Register">
    </form>
    <p>Already have an account? <a asp-action="Login" class="login">Log in</a>.</p>
</div>
@section ValidationScript
{
    <partial name="_ValidationScriptsPartial" />
}

